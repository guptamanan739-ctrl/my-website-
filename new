<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Windows Security</title>
<style>
* {
  box-sizing: border-box;
  cursor: none !important;
  user-select: none;
}
html, body {
  margin: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  font-family: "Segoe UI", Arial, sans-serif;
  background: #10141b;
  color: white;
}
#desktop {
  position: fixed;
  inset: 0;
  background:
    radial-gradient(ellipse at 25% 20%, #27364c, transparent 55%),
    linear-gradient(135deg, #101923, #05070b);
}
.topbar {
  height: 38px;
  background: #161d27;
  display: flex;
  align-items: center;
  padding: 0 15px;
  color: #d9e1eb;
  font-size: 13px;
}
#dialog {
  position: absolute;
  width: min(440px, calc(100vw - 32px));
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: #f5f5f5;
  color: #222;
  border: 1px solid #aaa;
  box-shadow: 0 20px 90px #000b;
}
.titlebar {
  height: 42px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 14px;
  background: #fff;
  font-size: 13px;
}
.close {
  color: #555;
  font-size: 21px;
}
.content {
  padding: 27px 28px 22px;
}
.warning {
  display: flex;
  gap: 17px;
  align-items: flex-start;
}
.symbol {
  font-size: 38px;
  color: #d69b18;
}
h3 {
  font-size: 19px;
  font-weight: 500;
  margin: 3px 0 12px;
}
p {
  font-size: 14px;
  line-height: 1.6;
  color: #444;
}
.status {
  margin-top: 18px;
  background: #e8e8e8;
  padding: 10px;
  font-size: 12px;
  color: #555;
}
.buttons {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 24px;
}
button {
  cursor: pointer;
  border: 1px solid #999;
  background: #fff;
  color: #222;
  min-width: 90px;
  padding: 9px 17px;
  font-size: 13px;
}
button.primary {
  background: #0866c6;
  color: white;
  border-color: #0866c6;
}
#toast {
  font-size: 12px;
  margin-top: 12px;
  color: #b3261e;
  min-height: 18px;
}
#bsod {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 10;
  background: #0078d7;
  padding: 10vh 10vw;
  color: white;
}
#bsod.show {
  display: block;
}
.sad {
  font-size: clamp(70px, 10vw, 110px);
  font-weight: 300;
  line-height: 1.15;
}
.bmsg {
  font-size: clamp(21px, 3vw, 36px);
  line-height: 1.4;
  max-width: 900px;
  margin-top: 20px;
}
.percent {
  font-size: 21px;
  margin-top: 28px;
}
.qr {
  margin-top: 30px;
  font-size: 14px;
  line-height: 1.7;
}
#exitHint {
  position: fixed;
  bottom: 10px;
  right: 12px;
  font-size: 10px;
  opacity: .12;
}
</style>
</head>
<body>
<div id="desktop">
  <div class="topbar">
    <span>▦ &nbsp; Windows Network Center</span>
  </div>

  <div id="dialog">
    <div class="titlebar">
      <span>Network Connection Diagnostics</span>
      <span class="close">×</span>
    </div>
    <div class="content">
      <div class="warning">
        <div class="symbol">⚠</div>
        <div>
          <h3>No Internet Connection</h3>
          <p>
            Your device is connected to the network, but
            the internet isn't responding.
          </p>
          <p>
            Windows cannot reach the connection verification
            server. Some services may be unavailable.
          </p>
        </div>
      </div>

      <div class="status" id="status">
        Error: NETWORK_CONNECTION_TIMEOUT<br>
        Status: Waiting for response...
      </div>

      <div class="buttons">
        <button id="cancel">Cancel</button>
        <button class="primary" id="retry">Retry</button>
      </div>
      <div id="toast"></div>
    </div>
  </div>
</div>

<div id="bsod">
  <div class="sad">:(</div>
  <div class="bmsg">
    Your PC ran into a problem and needs to restart.
    We're just collecting some error info, and then
    we'll restart for you.
  </div>
  <div class="percent">
    <span id="pct">0</span>% complete
  </div>
  <div class="qr">
    For more information about this issue and possible fixes, visit<br>
    https://www.windows.com/stopcode<br><br>
    Stop code: CRITICAL_PROCESS_DIED
  </div>
</div>

<div id="exitHint">Press ESC to exit simulation</div>

<script>
const dialog = document.getElementById("dialog");
const bsod = document.getElementById("bsod");
const toast = document.getElementById("toast");
const statusBox = document.getElementById("status");
const pct = document.getElementById("pct");

let crashed = false;
let retryCount = 0;
let timer;

async function fullscreen() {
  try {
    if (!document.fullscreenElement) {
      await document.documentElement.requestFullscreen();
    }
  } catch (e) {
    // Fullscreen can be blocked by browser settings.
  }
}

function crash() {
  if (crashed) return;
  crashed = true;

  fullscreen();
  dialog.style.display = "none";
  bsod.classList.add("show");

  let n = 0;
  timer = setInterval(() => {
    n = Math.min(100, n + Math.floor(Math.random() * 3) + 1);
    pct.textContent = n;
    if (n >= 100) clearInterval(timer);
  }, 650);
}

// Any click on the page launches the simulated BSOD.
document.addEventListener("click", crash);

document.getElementById("retry").addEventListener("click", e => {
  e.stopPropagation();
  retryCount++;
  toast.textContent = "Retrying connection... Attempt " + retryCount;
  statusBox.innerHTML =
    "Checking network adapter...<br>Status: Connection timed out";
});

document.getElementById("cancel").addEventListener("click", e => {
  e.stopPropagation();
  toast.textContent = "Operation cancelled. Connection still unavailable.";
});

document.addEventListener("contextmenu", e => e.preventDefault());
document.addEventListener("dragstart", e => e.preventDefault());

document.addEventListener("keydown", async e => {
  if (e.key === "Escape") {
    clearInterval(timer);
    bsod.classList.remove("show");
    dialog.style.display = "block";
    toast.textContent = "";
    pct.textContent = "0";
    crashed = false;

    if (document.fullscreenElement) {
      try {
        await document.exitFullscreen();
      } catch (err) {}
    }
  }
});
</script>
</body>
</html>
